# Copiez ce fichier en ".env" dans le dossier functions/ et renseignez vos clés.
# Le plan Firebase Blaze (pay-as-you-go) est requis pour déployer les Cloud Functions.

# Clé API Gemini/Imagen — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clé secrète Stripe — https://dashboard.stripe.com/apikeys (commence par sk_)
STRIPE_SECRET_KEY=

# Secret de signature du webhook Stripe — https://dashboard.stripe.com/webhooks
# Créez un endpoint pointant vers l'URL de la fonction stripeWebhook après déploiement,
# écoutant l'événement "checkout.session.completed" (commence par whsec_)
STRIPE_WEBHOOK_SECRET=

